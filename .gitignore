# Unicode's bidirectional conformance suites, fetched by `make bidi-tests`.
testdata/unicode-bidi/

# Unicode's normalisation conformance suite, fetched by `make normalization-tests`.
testdata/unicode-normalization/

# Unicode's property files, fetched by `make ucd` and read by every generator
# that derives a table from them.
testdata/ucd/
# The ICU word lists cmd/gendict reads. The generated table is committed; the
# source is fetched, like every other upstream data file here.
testdata/icu-dictionaries/

# Google's OFL font library, fetched for the broad sweeps. Two thousand families
# and 2.4 GB of faces: far too much to vendor, and the point of it is breadth
# rather than a fixed set anybody could review. The six faces the checked-in
# oracle uses stay where they are.
testdata/googlefonts/

# Noto's CJK faces, fetched for the same sweeps. The OFL library above is
# TrueType throughout, so it says nothing at all about CFF — and the static CJK
# faces are the CID-keyed CFF this module cannot yet read. Only the subset OTFs
# are taken, which is a few hundred megabytes against the repository's seven
# gigabytes.
testdata/notocjk/

# BudouX's phrase models, which cmd/genphrase reads. As with the ICU word lists
# above, the generated table is committed and the source is fetched.
testdata/budoux/

# hyph-utf8's pattern files, which cmd/genhyphen reads. Same arrangement: the
# table is committed, the half-megabyte of TeX it was made from is not.
testdata/hyphen/

# The other generators' inputs, fetched at a pinned commit by the Makefile and
# read by cmd/regenerate_test.go: Adobe's AFM files (matplotlib's copies), the
# reference Brotli's two table sources, and Adobe's Glyph List.
testdata/afm/
testdata/brotli-source/
testdata/agl/

# The licences THIRD_PARTY_NOTICES quotes and no generator reads, fetched at a
# pin by `make notice-sources` so that cmd/notices_test.go can hold every
# quotation to its source.
testdata/notices/

# HarfBuzz's three ms-use files, fetched at a pin by `make ms-use-sources`.
# NOTICE.md beside them is committed.
testdata/ms-use/*.txt
testdata/ms-use/.ok-*

# Built by `make hbfuzz`.
testdata/harfbuzz/.shapetext

# The Python environment the HarfBuzz oracle needs.
.hbenv/
__pycache__/

# The CoreText harness, built on a Mac.
testdata/coretext/shape
testdata/coretext/out-*.txt

# The layout engine's corpora: fetched by the Makefile, never committed.
testdata/wpt/
testdata/css-parsing-tests/
testdata/fonts-noto/
testdata/html/
testdata/css-color-4/
testdata/unicode-grapheme/

# HarfBuzz's table of BCP 47 language tags, which cmd/genlangtags reads. The
# generated table is committed; the header is fetched at a pinned release.
testdata/harfbuzz-langtags/
